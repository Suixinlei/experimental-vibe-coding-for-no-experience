# ─── OS / Editor ─────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# ─── Secrets / env ───────────────────────────────────────
.env
.env.*
!.env.example

# ─── backend (Bun + TypeScript) ──────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo
bun.lockb

# SQLite files (data lives outside git; only .gitkeep is tracked)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ─── iOS / Xcode ─────────────────────────────────────────
# Build products
ios/**/build/
ios/**/DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
*.xccheckout

# Per-user Xcode settings
xcuserdata/

# CocoaPods (only if used later)
ios/Pods/

# Swift Package Manager
.swiftpm/
Package.resolved

# Nested git backup (see ios/PomodAero/.git.bak — legacy from Xcode auto-init)
.git.bak/

# Fastlane (only if used later)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ─── Logs / coverage ─────────────────────────────────────
*.log
logs/
coverage/
.nyc_output/
