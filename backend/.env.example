# Copy this file to `.env` and fill in real values for local dev.
# `.env` is gitignored — never commit secrets.

# HTTP server
PORT=3000
HOST=127.0.0.1

# SQLite database file (relative to backend/ directory)
DATABASE_URL=./data/app.db

# CORS — comma-separated list of allowed origins. Use * for dev only.
CORS_ORIGINS=*

# Logging
LOG_LEVEL=info
